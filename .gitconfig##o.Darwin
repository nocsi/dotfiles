[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
#[commit]
#    gpgsign = true
[alias]
	up = !git pull --prune $@ && git submodule update --init --recursive
#[credential]
#    helper = osxkeychain
[pull]
	rebase = false
	ff = only
[color]
	ui = true
[core]
	pager = less -r
