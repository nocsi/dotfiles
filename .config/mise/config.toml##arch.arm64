[settings]
experimental = true

[tools]
node = "20.10.0"
watchexec = "latest"
"cargo:cargo-binstall" = "latest"
zigmod = "latest"
tuist = "latest"
pkl = "0.26.3"
perl = "5.40.0"
bun = "1.1"
java = "openjdk-23"
maven = "3.9.9"
rust = "1.82.0"
erlang = "27.1.2"
zig = "0.13.0"
python = "3.12.7"
elixir = "1.17.3-otp-27"
pnpm = "9.12.3"
go = "1.23.2"
lua = "5.1"
gleam = "1.1.0"

[env]
CC="clang"
CXX="/opt/homebrew/opt/llvm/bin/clang++"
CPP="/opt/homebrew/opt/llvm/bin/clang -E"
CLANG="/opt/homebrew/opt/llvm/bin/clang"
KERL_BUILD_BACKEND="git"
KERL_BUILD_DOCS="yes"
KERL_DOC_TARGETS="chunks"
KERL_USE_AUTOCONF=0
KERL_CONFIGURE_OPTIONS="""
--enable-m64-build \
--disable-debug \
--enable-hipe \
--disable-sctp \
--disable-silent-rules \
--enable-kernel-poll \
--enable-darwin-64bit \
--enable-dirty-schedulers \
--enable-dynamic-ssl-lib \
--enable-shared-zlib \
--enable-sharing-preserving \
--enable-kernel-poll \
--enable-lock-counter \
--enable-smp-support \
--enable-threads \
--enable-vm-probes \
--enable-webview \
--enable-wx \
--enable-gettimeofday-as-os-system-time  \
--with-ssl=/opt/homebrew/opt/openssl \
--with-ssl-incl=/opt/homebrew/opt/openssl \
--with-wx-config=/opt/homebrew/bin/wx-config \
--without-javac \
--without-jinterface \
--without-odbc \
--with-dynamic-trace=dtrace \
--disable-native-libs \
--disable-jit \
--with-wx"""

CFLAGS="-O2 -g -fno-stack-check -Wno-error=implicit-function-declaration -I/opt/homebrew/opt/llvm/include -I/opt/homebrew/opt/openssl/include -I$/opt/homebrew/opt/bzip2/include -I/opt/homebrew/opt/readline/include"
CPPFLAGS="-I/opt/homebrew/opt/llvm/include -I/opt/homebrew/opt/zlib/include -I/opt/homebrew/opt/bzip2/include -I/opt/homebrew/opt/libffi/include -I/opt/homebrew/opt/sqlite3/include"
LDFLAGS="-L/opt/homebrew/opt/openssl/lib -L/opt/homebrew/opt/readline/lib -L/opt/homebrew/opt/zlib/lib -L/opt/homebrew/opt/bzip2/lib -L/opt/homebrew/opt/libffi/lib -L/opt/homebrew/opt/llvm/lib/c++ -L/opt/homebrew/opt/llvm/lib/unwind -lunwind"
PKG_CONFIG_PATH="/opt/homebrew/opt/openssl/lib/pkgconfig:$(brew --prefix readline)/lib/pkgconfig:$(brew --prefix zlib)/lib/pkgconfig:$(brew --prefix bzip2)/lib/pkgconfig:$(brew --prefix sqlite3)/lib/pkgconfig"
RUBY_CONFIGURE_OPTS="--enable-yjit --with-openssl-dir=/opt/homebrew/opt/openssl --with-readline-dir=/opt/homebrew/opt/readline --with-libyaml-dir=/opt/homebrew/opt/libyaml --with-gmp-dir=/opt/homebrew/opt/gmp"
PYTHON_CONFIGURE_OPTS="--enable-framework --enable-optimizations --with-lto=full"
MAKEFLAGS="-j10"
