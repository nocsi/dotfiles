# AEROSPACE CONFIG
start-at-login = true

after-login-command = []

after-startup-command = [
  'exec-and-forget sketchybar >> $HOME/.sketchybar/service.log 2>&1',
  'exec-and-forget borders active_color=0xffe1e3e4 inactive_color=0xff494d64 width=5.0',
  #'exec-and-forget borders active_color=0xffc6a0f6 inactive_color=0xff939ab7 width=6.0 hidpi=on', # requires https://github.com/FelixKratz/JankyBorders
  #     'exec-and-forget /opt/homebrew/opt/sketchybar/bin/sketchybar'
]

exec-on-workspace-change = [
  '/bin/bash',
  '-c',
  'sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE FOCUSED_DISPLAY=$(aerospace list-monitors --focused | awk "{print $1}")',
  #'sketchybar --trigger aerospace_workspace_changed FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE',
]

on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

on-focus-changed = [
  'move-mouse window-lazy-center',
  'exec-and-forget sketchybar --trigger aerospace_focus_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE',
  'exec-and-forget /bin/bash -c /opt/homebrew/bin/sketchybar --trigger front_app_switched',
  'exec-and-forget sketchybar --trigger update_windows',
]

enable-normalization-flatten-containers = false
enable-normalization-opposite-orientation-for-nested-containers = true

accordion-padding = 30

non-empty-workspaces-root-containers-layout-on-startup = 'smart'

default-root-container-layout = 'tiles'

default-root-container-orientation = 'auto'

key-mapping.preset = 'qwerty'

[gaps]
# Allow for more space on smaller screens
inner.horizontal = [{ monitor."Built-in Retina Display" = 10 }, 15]
inner.vertical = [{ monitor."Built-in Retina Display" = 10 }, 15]
outer.left = [{ monitor."Built-in Retina Display" = 5 }, 25]
outer.bottom = [{ monitor."Built-in Retina Display" = 5 }, 10]
outer.top = [
  { monitor."Built-in Retina Display" = 5 },
  { monitor."LG HDR 4K" = 40 },
  { monitor."Sidecar Display" = 40 },
  52,
]
outer.right = [{ monitor."Built-in Retina Display" = 5 }, 25]

[exec] # Again, you don't need to copy all config sections to your config.
inherit-env-vars = true # If you don't touch "exec" section,
[exec.env-vars] # it will fallback to "default-config.toml"
PATH = '/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}'

[mode.main.binding]
alt-t = 'exec-and-forget wezterm start'

# See: https://nikitabobko.github.io/AeroSpace/commands#layout
alt-slash = 'layout tiles horizontal vertical'
alt-comma = 'layout accordion horizontal vertical'
alt-space = 'layout floating tiling'
alt-r = [
  'mode resize',
  'exec-and-forget sketchybar --trigger send_message MESSAGE="RESIZE MODE" HOLD="true"',
]

cmd-keypadMinus = 'resize smart -70'
cmd-keypadPlus = 'resize smart +70'

cmd-g = 'mode join'
cmd-q = ['close --quit-if-last-window']

# cmd-w = []

# All possible keys:
# - Letters.        a, b, c, ..., z
# - Numbers.        0, 1, 2, ..., 9
# - Keypad numbers. keypad0, keypad1, keypad2, ..., keypad9
# - F-keys.         f1, f2, ..., f20
# - Special keys.   minus, equal, period, comma, slash, backslash, quote, semicolon, backtick,
#                   leftSquareBracket, rightSquareBracket, space, enter, esc, backspace, tab
# - Keypad special. keypadClear, keypadDecimalMark, keypadDivide, keypadEnter, keypadEqual,
#                   keypadMinus, keypadMultiply, keypadPlus
# - Arrows.         left, down, up, right

# All possible modifiers: cmd, alt, ctrl, shift

cmd-enter = 'exec-and-forget open -n /Volumes/Macintosh\ HD/Applications/Wezterm.app'
cmd-m = 'exec-and-forget open -n /Volumes/Macintosh\ HD/Applications/Marta.app'

cmd-shift-f = 'macos-native-fullscreen'
# cmd-f = 'fullscreen'

alt-g = 'split horizontal'
alt-v = 'split vertical'

cmd-alt-ctrl-h = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop left'
cmd-alt-ctrl-j = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop down'
cmd-alt-ctrl-k = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop up'
cmd-alt-ctrl-l = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop right'
cmd-left = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop left'
cmd-down = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop down'
cmd-up = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop up'
cmd-right = 'focus --boundaries all-monitors-outer-frame --boundaries-action stop right'

cmd-alt-shift-h = 'move left'
cmd-alt-shift-j = 'move down'
cmd-alt-shift-k = 'move up'
cmd-alt-shift-l = 'move right'
cmd-alt-shift-left = 'move left'
cmd-alt-shift-down = 'move down'
cmd-alt-shift-up = 'move up'
cmd-alt-shift-right = 'move right'


alt-shift-h = ['join-with left', 'mode main']
alt-shift-j = ['join-with down', 'mode main']
alt-shift-k = ['join-with up', 'mode main']
alt-shift-l = ['join-with right', 'mode main']

cmd-1 = 'workspace --auto-back-and-forth 1'  # Notes
cmd-2 = 'workspace --auto-back-and-forth 2'  # Terminal
cmd-3 = 'workspace --auto-back-and-forth 3'  # Browser
cmd-4 = 'workspace --auto-back-and-forth 4'  # AltBrowser
cmd-5 = 'workspace --auto-back-and-forth 5'  # Remote
cmd-6 = 'workspace --auto-back-and-forth 6'  # Database
cmd-7 = 'workspace --auto-back-and-forth 7'  # Chat
cmd-8 = 'workspace --auto-back-and-forth 8'  # Mail
cmd-9 = 'workspace --auto-back-and-forth 9'  # Music
cmd-0 = 'workspace --auto-back-and-forth 10' # Secrets
# cmd-t = 'workspace --auto-back-and-forth t'  # Meeting

alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'
alt-shift-6 = 'move-node-to-workspace 6'
alt-shift-7 = 'move-node-to-workspace 7'
alt-shift-8 = 'move-node-to-workspace 8'
alt-shift-9 = 'move-node-to-workspace 9'
alt-shift-0 = 'move-node-to-workspace 10'
# cmd-shift-t = 'move-node-to-workspace t'


ctrl-alt-shift-cmd-n = 'workspace next'
ctrl-alt-shift-cmd-p = 'workspace prev'
ctrl-alt-shift-cmd-c = 'reload-config'


alt-tab = 'workspace-back-and-forth'

# See: https://nikitabobko.github.io/AeroSpace/commands#move-workspace-to-monitor
alt-shift-tab = 'move-workspace-to-monitor --wrap-around next'

# See: https://nikitabobko.github.io/AeroSpace/commands#mode
alt-shift-semicolon = [
  'mode service',
  'exec-and-forget sketchybar --trigger aerospace_enter_service_mode',
]
alt-p = 'move-workspace-to-monitor --wrap-around next'
alt-shift-p = [
  'move-node-to-monitor --wrap-around next',
  'focus-monitor next --wrap-around',
]
cmd-alt-h = []

alt-shift-s = [
  'mode service',
  'exec-and-forget sketchybar --trigger send_message MESSAGE="SERVICE MODE" HOLD="true"',
]

[mode.service.binding]
esc = [
  'reload-config',
  'exec-and-forget sketchybar --trigger hide_message',
  'exec-and-forget sketchybar --reload',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
]
r = ['flatten-workspace-tree', 'mode main'] # reset layout
#s = ['layout sticky tiling', 'mode main'] # sticky is not yet supported https://github.com/nikitabobko/AeroSpace/issues/2
f = [
  'layout floating tiling',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
] # Toggle between floating and tiling layout
backspace = [
  'close-all-windows-but-current',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
]

alt-shift-left = [
  'join-with left',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
]
alt-shift-down = [
  'join-with down',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
]
alt-shift-up = [
  'join-with up',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
]
alt-shift-right = [
  'join-with right',
  'mode main',
  'exec-and-forget sketchybar --trigger aerospace_leave_service_mode',
]


b = [
  'exec-and-forget ~/.config/aerospace/presentation.sh on',
  'exec-and-forget sketchybar --bar height=0',
  'exec-and-forget sketchybar --trigger hide_message',
  'mode main',
]
shift-b = [
  'exec-and-forget ~/.config/aerospace/presentation.sh off',
  'exec-and-forget sketchybar --bar height=36',
  'exec-and-forget sketchybar --trigger hide_message',
  'mode main',
]

[mode.resize.binding]
keypadMinus = 'resize smart -70'
keypadPlus = 'resize smart +70'
h = ['resize width -64']
j = ['resize height -64']
k = ['resize height +64']
l = ['resize width +64']
esc = ['mode main', 'exec-and-forget sketchybar --trigger hide_message']
enter = ['mode main', 'exec-and-forget sketchybar --trigger hide_message']

[mode.join.binding]
h = ['join-with left', 'mode main']
j = ['join-with down', 'mode main']
k = ['join-with up', 'mode main']
l = ['join-with right', 'mode main']
cmd-h = ['join-with left', 'mode main']
cmd-alt-h = ['join-with left', 'mode main']

#[[on-window-detected]]
#if.app-name-regex-substring = ".*"
#    run = "layout floating"

[[on-window-detected]]
if.app-name-regex-substring = '^wezterm-gui$'
run = ['layout tiling', 'move-node-to-workspace 2']


[[on-window-detected]]
if.app-id = 'com.apple.safari'
run = ['layout tiling', 'move-node-to-workspace 3']

[[on-window-detected]]
if.app-id = 'org.qutebrowser.qutebrowser'
run = ['layout tiling', 'move-node-to-workspace 3']

[[on-window-detected]]
if.app-id = 'md.obsidian'
run = ['layout tiling', 'move-node-to-workspace 1']


# Windows that should float
[[on-window-detected]]
if.app-id = 'com.apple.systempreferences'
run = 'layout floating'
[[on-window-detected]]
if.app-id = 'com.googlecode.iterm2'
run = 'layout floating'
[[on-window-detected]]
if.app-id = 'com.runningwithcrayons.Alfred-Preferences'
run = 'layout floating'
[[on-window-detected]]
if.app-id = 'com.corecode.MacUpdater'
run = 'layout floating'
[[on-window-detected]]
if.app-id = 'com.apple.AppStore'
run = 'layout floating'
[[on-window-detected]]
if.app-id = 'com.apple.finder'
run = ['layout floating']

[[on-window-detected]]
if.app-id = 'com.spotify.client'
run = ['move-node-to-workspace 9']


## move to social workspace
[[on-window-detected]]
if.app-id = 'com.apple.MobileSMS'
run = ['move-node-to-workspace 7']
[[on-window-detected]]
if.app-id = 'com.readdle.smartemail-Mac'
run = ['move-node-to-workspace 7']

[[on-window-detected]]
if.app-id = 'com.microsoft.teams2'
run = ['move-node-to-workspace 7']

[[on-window-detected]]
if.app-id = 'com.microsoft.Outlook'
run = ['move-node-to-workspace 8']

[[on-window-detected]]
if.app-id = 'com.bitwarden.desktop'
run = ['move-node-to-workspace 10']

[[on-window-detected]]
if.app-id = 'com.microsoft.edgemac'
run = ['move-node-to-workspace 4']

[[on-window-detected]]
if.app-id = 'com.microsoft.rdc.macos'
run = ['move-node-to-workspace 5']

[[on-window-detected]]
if.app-id = 'org.jkiss.dbeaver.core.product'
run = ['move-node-to-workspace 6']
