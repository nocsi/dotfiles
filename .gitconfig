[init]
  defaultBranch = main
[user]
  name = Loc Nguyen
  email = l@nocsi.com
  signingkey = 43B69474 
[diff]
	tool = meld
[merge]
	tool = meld
[difftool]
	prompt = false
[core]
	pager = diff-so-fancy | less -RFXMx4
	untrackedCache = true
[color]
  ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = yellow
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[gpg]
	program = /usr/local/MacGPG2/bin/gpg2
[credential "https://github.com"]
  username = nocsi
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
  patch = apply --ignore-space-change --ignore-whitespace
	lg = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)&lt;%an&gt;%Creset' --abbrev-commit"
[http]
	emptyAuth = true
	postBuffer = 524288000
#[commit]
#	gpgsign = true
[core]
	editor = nvim
	excludesfile = /Users/locnguyen/.gitignore_global
	pager = less -i
[tag]
	forceSignAnnotated = true
[push]
	default = current
[pull]
	default = current
	rebase = false
[oh-my-zsh]
	hide-status = 1
	hide-dirty = 1
[credential]
	helper = cache
[submodule]
	recurse = true
	fetchJobs = 0
